    "url": "git+https://github.com/0FlowerOcean0/bloomtype-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/0FlowerOcean0/bloomtype-obsidian/issues"
  },
  "homepage": "https://github.com/0FlowerOcean0/bloomtype-obsidian#readme",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
